# Mot de passe administrateur pour protéger /admin, /configure et les API d'écriture.
# Laissez vide (ou ne créez pas .env.local) en développement local pour un accès libre.
ADMIN_PASSWORD=changez-moi-avec-un-mot-de-passe-robuste

# Clé secrète utilisée pour signer le cookie de session (recommandé en production)
AUTH_SECRET=remplacez-par-une-longue-chaine-aleatoire

# Port d'écoute local du serveur Next.js (le tunnel Cloudflare pointera vers ce port)
PORT=3000
